{
  "name": "tantiya",
  "version": "0.1.0",
  "private": true,
  "description": "Offline AI damage triage for post-typhoon shelter assistance. Runs fully on one laptop.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "warmup": "node scripts/warmup.mjs",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "eval": "node scripts/eval.mjs",
    "typecheck": "tsc --noEmit -p web"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.54.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
